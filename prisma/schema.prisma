// PalmAI database schema (PostgreSQL).
// Structured AI output is stored as JSONB and is always validated with Zod
// before it is written (see src/lib/schemas).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum Hand {
  LEFT
  RIGHT
}

enum ReadingStatus {
  PENDING
  ANALYZING
  ANALYZED
  INTERPRETING
  COMPLETE
  REJECTED
  FAILED
}

enum PaymentProvider {
  STRIPE
  RAZORPAY
  MOCK
  /// Paid from the user's PalmAI wallet balance (no new money; not counted as revenue).
  WALLET
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  /// The customer closed or abandoned checkout. The reading stays locked.
  CANCELLED
  REFUNDED
}

enum EntitlementType {
  READING_PREMIUM
  PREMIUM_SUBSCRIPTION
  /// Unlocks one couple-compatibility reading.
  COMPATIBILITY
}

/// What a payment (or wallet purchase) buys. Prices live in src/lib/monetization/products.ts.
enum ProductKind {
  DETAILED_READING
  COUPLE_COMPATIBILITY
  FAMILY_PACK
  GIFT_READING
  MEMBERSHIP_YEAR
  WALLET_TOPUP
  READER_QUESTIONS
  KUNDLI_REPORT
  MILAN_REPORT
  RASHIFAL_REPORT
}

enum ReadingRole {
  /// The visitor's own palm.
  SELF
  /// A partner's palm, uploaded with their permission for a compatibility reading.
  PARTNER
}

/// Balance a ledger entry changes.
enum LedgerUnit {
  /// Closed-loop wallet balance, in paise.
  WALLET_PAISE
  /// Detailed-reading credits (family pack, gifts, referral rewards).
  READING_CREDIT
}

enum CompatibilityStatus {
  LOCKED
  GENERATING
  COMPLETE
  FAILED
}

model User {
  id             String   @id @default(cuid())
  email          String   @unique
  passwordHash   String
  name           String?
  role           Role     @default(USER)
  /// Explicit opt-in to allow palm photos to be used for model improvement.
  trainingOptIn  Boolean  @default(false)
  /// Closed-loop wallet balance in paise (spendable only on PalmAI, not withdrawable).
  walletBalance  Int      @default(0)
  readingCredits Int      @default(0)
  referralCode   String?  @unique
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  sessions        Session[]
  readings        Reading[]
  payments        Payment[]
  entitlements    Entitlement[]
  ledger          LedgerEntry[]
  giftsBought     GiftCode[]      @relation("GiftPurchaser")
  giftsRedeemed   GiftCode[]      @relation("GiftRecipient")
  referralsMade   Referral[]      @relation("Referrer")
  referredBy      Referral?       @relation("Referred")
  compatibilities Compatibility[]
  readerChats     ReaderChat[]
  kundlis         KundliProfile[]
  milans          MilanProfile[]
}

model Session {
  id         String   @id @default(cuid())
  /// SHA-256 of the session token; the raw token only lives in the user's cookie.
  tokenHash  String   @unique
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Reading {
  id                 String        @id @default(cuid())
  userId             String?
  user               User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// SHA-256 of the anonymous guest cookie that created the reading.
  guestKeyHash       String?
  hand               Hand
  role               ReadingRole   @default(SELF)
  status             ReadingStatus @default(PENDING)
  /// Private object-storage keys. Never public URLs.
  imageKey           String?
  thumbnailKey       String?
  imageDeletedAt     DateTime?
  imageWidth         Int?
  imageHeight        Int?
  /// 0–1 confidence in the image analysis (not in any palmistry claim).
  analysisConfidence Float?
  qualityScore       Float?
  rejectionReason    String?
  errorCode          String?
  trainingOptIn      Boolean       @default(false)
  /// True when produced by the mock AI provider (sample data, not the user's photo).
  isDemo             Boolean       @default(false)
  aiProvider         String?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  completedAt        DateTime?

  analysis                 PalmAnalysis?
  interpretation           PalmInterpretation?
  payments                 Payment[]
  entitlements             Entitlement[]
  compatibilitiesAsSelf    Compatibility[]     @relation("CompatibilitySelf")
  compatibilitiesAsPartner Compatibility[]     @relation("CompatibilityPartner")
  readerChats              ReaderChat[]

  @@index([userId, createdAt])
  @@index([guestKeyHash])
  @@index([status])
  @@index([createdAt])
}

model PalmAnalysis {
  id                String   @id @default(cuid())
  readingId         String   @unique
  reading           Reading  @relation(fields: [readingId], references: [id], onDelete: Cascade)
  /// Validated PalmAnalysisSchema JSON.
  data              Json
  schemaVersion     Int
  promptVersion     String
  provider          String
  model             String
  overallConfidence Float
  attempts          Int      @default(1)
  createdAt         DateTime @default(now())
}

model PalmInterpretation {
  id            String   @id @default(cuid())
  readingId     String   @unique
  reading       Reading  @relation(fields: [readingId], references: [id], onDelete: Cascade)
  /// Validated, grounding-checked PalmInterpretationSchema JSON (full premium content).
  data          Json
  schemaVersion Int
  promptVersion String
  provider      String
  model         String
  /// Number of statements removed by grounding/safety filters.
  removedCount  Int      @default(0)
  attempts      Int      @default(1)
  createdAt     DateTime @default(now())
}

model Payment {
  id                String          @id @default(cuid())
  userId            String?
  user              User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  readingId         String?
  reading           Reading?        @relation(fields: [readingId], references: [id], onDelete: SetNull)
  provider          PaymentProvider
  product           ProductKind     @default(DETAILED_READING)
  compatibilityId   String?
  compatibility     Compatibility?  @relation(fields: [compatibilityId], references: [id], onDelete: SetNull)
  milanId           String?
  milan             MilanProfile?   @relation(fields: [milanId], references: [id], onDelete: SetNull)
  kundliId          String?
  kundli            KundliProfile?  @relation(fields: [kundliId], references: [id], onDelete: SetNull)
  readerChatId      String?
  readerChat        ReaderChat?     @relation(fields: [readerChatId], references: [id], onDelete: SetNull)
  /// Units bought (e.g. questions for a reader chat).
  quantity          Int             @default(1)
  /// Checkout session id (Stripe) or order id (Razorpay).
  providerRef       String?         @unique
  providerPaymentId String?
  amount            Int
  currency          String
  status            PaymentStatus   @default(PENDING)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  paidAt            DateTime?

  entitlement Entitlement?
  gift        GiftCode?

  @@index([userId])
  @@index([readingId])
  @@index([compatibilityId])
  @@index([milanId])
  @@index([kundliId])
  @@index([readerChatId])
  @@index([status, createdAt])
  @@index([product, status])
}

model Entitlement {
  id              String          @id @default(cuid())
  type            EntitlementType
  userId          String?
  user            User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  readingId       String?
  reading         Reading?        @relation(fields: [readingId], references: [id], onDelete: Cascade)
  paymentId       String?         @unique
  payment         Payment?        @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  compatibilityId String?
  compatibility   Compatibility?  @relation(fields: [compatibilityId], references: [id], onDelete: Cascade)
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime        @default(now())

  @@index([userId])
  @@index([readingId])
}

/// Minimal, non-identifying product analytics.
model UsageEvent {
  id         String   @id @default(cuid())
  name       String
  userId     String?
  readingId  String?
  properties Json?
  createdAt  DateTime @default(now())

  @@index([name, createdAt])
  @@index([createdAt])
  @@index([userId])
}

/// Idempotency log for payment webhooks.
model ProcessedWebhookEvent {
  id        String   @id
  provider  String
  createdAt DateTime @default(now())
}

/// Append-only record of every wallet and credit change (the balances on User mirror it).
model LedgerEntry {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  unit      LedgerUnit
  delta     Int
  reason    String
  /// Payment, gift, referral or reading this entry relates to (makes grants idempotent).
  refId     String?
  createdAt DateTime   @default(now())

  @@unique([unit, reason, refId])
  @@index([userId, createdAt])
}

model GiftCode {
  id           String    @id @default(cuid())
  code         String    @unique
  purchaserId  String?
  purchaser    User?     @relation("GiftPurchaser", fields: [purchaserId], references: [id], onDelete: SetNull)
  paymentId    String?   @unique
  payment      Payment?  @relation(fields: [paymentId], references: [id], onDelete: SetNull)
  redeemedById String?
  redeemedBy   User?     @relation("GiftRecipient", fields: [redeemedById], references: [id], onDelete: SetNull)
  redeemedAt   DateTime?
  expiresAt    DateTime
  createdAt    DateTime  @default(now())

  @@index([purchaserId])
}

model Referral {
  id          String    @id @default(cuid())
  referrerId  String
  referrer    User      @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referredId  String    @unique
  referred    User      @relation("Referred", fields: [referredId], references: [id], onDelete: Cascade)
  /// Set when the referred person completes their first reading.
  qualifiedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([referrerId, qualifiedAt])
}

model Compatibility {
  id               String              @id @default(cuid())
  userId           String?
  user             User?               @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestKeyHash     String?
  readingId        String
  reading          Reading             @relation("CompatibilitySelf", fields: [readingId], references: [id], onDelete: Cascade)
  partnerReadingId String
  partnerReading   Reading             @relation("CompatibilityPartner", fields: [partnerReadingId], references: [id], onDelete: Cascade)
  status           CompatibilityStatus @default(LOCKED)
  data             Json?
  provider         String?
  model            String?
  errorCode        String?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  completedAt      DateTime?

  payments     Payment[]
  entitlements Entitlement[]

  @@unique([readingId, partnerReadingId])
  @@index([userId])
  @@index([guestKeyHash])
}

enum ReaderMessageRole {
  USER
  READER
}

/// A chat with one of PalmAI's AI palm readers (always disclosed as AI).
model ReaderChat {
  id               String          @id @default(cuid())
  userId           String?
  user             User?           @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestKeyHash     String?
  /// Reader persona id from the catalogue (src/lib/readers/catalog.ts).
  readerId         String
  /// The palm reading the reader answers about, if any.
  readingId        String?
  reading          Reading?        @relation(fields: [readingId], references: [id], onDelete: SetNull)
  questionsAllowed Int             @default(0)
  questionsUsed    Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  messages         ReaderMessage[]
  payments         Payment[]

  @@index([userId])
  @@index([guestKeyHash])
}

model ReaderMessage {
  id        String            @id @default(cuid())
  chatId    String
  chat      ReaderChat        @relation(fields: [chatId], references: [id], onDelete: Cascade)
  role      ReaderMessageRole
  text      String
  createdAt DateTime          @default(now())

  @@index([chatId, createdAt])
}

/// Daily horoscope for one Moon sign, written once per day and language.
model DailyHoroscope {
  id        String   @id @default(cuid())
  /// Calendar date in IST, YYYY-MM-DD.
  date      String
  /// Rashi index 0 (Mesha) … 11 (Meena).
  sign      Int
  language  String
  data      Json
  provider  String
  createdAt DateTime @default(now())

  @@unique([date, sign, language])
}

enum KundliReportStatus {
  NONE
  GENERATING
  COMPLETE
  FAILED
}

/// A saved birth chart (only when the visitor asks for the paid Kundli reading).
model KundliProfile {
  id           String             @id @default(cuid())
  userId       String?
  user         User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestKeyHash String?
  name         String
  /// Birth details as entered (date, time, place, coordinates, UTC offset).
  birth        Json
  chart        Json
  /// The one free Mahakundli answer: { area, text }.
  teaser       Json?
  reportStatus KundliReportStatus @default(NONE)
  report       Json?
  /// Detailed Rashifal: a personal 12-month guide from this chart (paid).
  yearStatus   KundliReportStatus @default(NONE)
  yearReport   Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  payments     Payment[]

  @@index([userId])
  @@index([guestKeyHash])
}

/// A saved Kundli Milan (two birth charts and their Guna Milan).
model MilanProfile {
  id           String             @id @default(cuid())
  userId       String?
  user         User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  guestKeyHash String?
  nameA        String
  nameB        String
  birthA       Json
  birthB       Json
  chartA       Json
  chartB       Json
  /// Guna Milan result (8 kootas, total out of 36).
  result       Json
  reportStatus KundliReportStatus @default(NONE)
  report       Json?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  payments     Payment[]

  @@index([userId])
  @@index([guestKeyHash])
}
