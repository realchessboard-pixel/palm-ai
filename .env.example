# ---------------------------------------------------------------------------
# PalmAI environment variables. Copy to `.env` and fill in.
# NEVER commit real credentials. Only NEXT_PUBLIC_* values reach the browser.
# Empty values are treated as unset.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/palmai
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional branding
NEXT_PUBLIC_APP_NAME=PalmAI
NEXT_PUBLIC_SUPPORT_EMAIL=privacy@example.com

# Integration tests use a separate database (it gets truncated!)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/palmai_test

# --- AI (vision + interpretation) -----------------------------------------
# anthropic | openai | gemini | mock
#   mock = built-in SAMPLE features (does not look at the photo); readings are
#   labelled "Demo mode". Refused when NODE_ENV=production unless DEMO_MODE=true.
AI_PROVIDER=mock
AI_API_KEY=
# anthropic defaults to claude-opus-5-5; openai/gemini require AI_MODEL.
AI_MODEL=
# Optional different model for stage 2 (interpretation)
AI_INTERPRETATION_MODEL=
AI_TIMEOUT_MS=90000
AI_MAX_ATTEMPTS=2
# Anthropic effort level: low | medium | high
AI_EFFORT=medium

# --- Payments -----------------------------------------------------------------
# stripe | razorpay | mock | none
#   mock completes instantly with no money involved (dev/test only).
PAYMENT_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Price of the full report in MINOR units (cents, paise…) and ISO currency
PREMIUM_PRICE_AMOUNT=499
PREMIUM_PRICE_CURRENCY=usd

# --- Storage (private palm images) ----------------------------------------------
# local | s3 | memory
#   local: files under STORAGE_LOCAL_DIR (dev only — not for serverless hosts)
#   s3:    any S3-compatible private bucket (AWS S3, Cloudflare R2, Supabase…)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Uploads & retention ---------------------------------------------------------
# Max upload size in bytes after in-browser compression (Vercel's body limit is ~4.5 MB)
MAX_UPLOAD_BYTES=4194304
# Guest (no-account) readings and their photos are deleted after this many days
IMAGE_RETENTION_DAYS=30

# --- Operations -------------------------------------------------------------------
# Bearer token required by /api/cron/cleanup (Vercel Cron sends it automatically)
CRON_SECRET=
# Comma-separated emails that get admin access (or use `npm run admin:grant -- email`)
ADMIN_EMAILS=
# database | console | none
ANALYTICS_PROVIDER=database
# Allow mock AI + mock payments in a production build (private demos ONLY)
DEMO_MODE=false
