# ---------------------------------------------------------------------------
# PalmAI environment variables. Copy to `.env` and fill in.
# NEVER commit real credentials. Only NEXT_PUBLIC_* values reach the browser.
# Empty values are treated as unset.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/palmai
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional branding
NEXT_PUBLIC_APP_NAME=PalmAI
NEXT_PUBLIC_SUPPORT_EMAIL=privacy@example.com

# Integration tests use a separate database (it gets truncated!)
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/palmai_test

# --- AI (vision + interpretation) -----------------------------------------
# anthropic | openai | gemini | mock
#   mock = built-in SAMPLE features (does not look at the photo); readings are
#   labelled "Demo mode". Refused when NODE_ENV=production unless DEMO_MODE=true.
AI_PROVIDER=mock
AI_API_KEY=
# anthropic defaults to claude-opus-5-5; openai/gemini require AI_MODEL.
# Verified Gemini model: gemini-3.8-flash (stable, vision, JSON mode).
AI_MODEL=
# Optional different model for stage 2 (interpretation)
AI_INTERPRETATION_MODEL=
AI_TIMEOUT_MS=90000
AI_MAX_ATTEMPTS=2
# Anthropic effort level: low | medium | high
AI_EFFORT=medium
# Gemini "thinking" level per stage: low | medium | high. Analysis unset = the
# model's default (best measured vision quality); interpretation defaults to low
# (about half the latency, no measured loss in grounding or completeness).
AI_ANALYSIS_THINKING=
AI_INTERPRETATION_THINKING=low
# Paid content (detailed readings, Mahakundli, couple readings, paid reader questions)
# uses a stronger model with deeper thinking. Free content stays on AI_MODEL.
AI_PREMIUM_MODEL=gemini-pro-latest
AI_PREMIUM_THINKING=high
# Log per-step pipeline timings outside development (dev logs them by default)
PIPELINE_TIMING=

# --- Payments -----------------------------------------------------------------
# stripe | razorpay | mock | none
#   mock opens a sandbox checkout (simulate success / failure / cancel) with no
#   money involved. Refused in production unless DEMO_MODE; never counted as revenue.
PAYMENT_PROVIDER=none
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# The detailed-reading price (₹35) is set in src/lib/monetization/price.ts.

# --- Internal economics (admin dashboard only; estimates) ------------------------
# Estimated AI cost per completed basic reading, in INR. Not exact — adjust as
# measured. Never used for pricing or access, never shown to customers.
ESTIMATED_BASIC_AI_COST_INR=4
# Extra AI cost of a detailed reading (0: it reuses the basic reading's output)
ESTIMATED_EXTENDED_AI_COST_INR=0
# Leave unset until known; the dashboard reports them as "not configured".
PAYMENT_FEE_PERCENT=
PAYMENT_FEE_FIXED_INR=
AD_REVENUE_PER_1000_READINGS_INR=
# Optional model prices (INR per 1M tokens) for per-reading cost estimates in the
# internal beta report (/admin/beta). Thinking tokens count as output.
AI_COST_INPUT_PER_1M_TOKENS_INR=
AI_COST_OUTPUT_PER_1M_TOKENS_INR=

# --- Ads ---------------------------------------------------------------------
# off | placeholder. No ad network is integrated; "placeholder" shows marked
# development boxes on free results. Default: placeholder in dev, off elsewhere.
ADS_MODE=

# --- Storage (private palm images) ----------------------------------------------
# local | s3 | memory
#   local: files under STORAGE_LOCAL_DIR (dev only — not for serverless hosts)
#   s3:    any S3-compatible private bucket (AWS S3, Cloudflare R2, Supabase…)
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=./storage
STORAGE_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Uploads & retention ---------------------------------------------------------
# Max upload size in bytes after in-browser compression (Vercel's body limit is ~4.5 MB)
MAX_UPLOAD_BYTES=4194304
# Guest (no-account) readings and their photos are deleted after this many days
IMAGE_RETENTION_DAYS=30

# --- Operations -------------------------------------------------------------------
# Bearer token required by /api/cron/cleanup (Vercel Cron sends it automatically)
CRON_SECRET=
# Comma-separated emails that get admin access (or use `npm run admin:grant -- email`)
ADMIN_EMAILS=
# database | console | none
ANALYTICS_PROVIDER=database
# Allow mock AI + mock payments in a production build (private demos ONLY)
DEMO_MODE=false
